APP_NAME=FastAPI Simple App
API_PREFIX=/api/v1
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
TOKEN_EXPIRE_MINUTES=60
DATABASE_PATH=app.db
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
STAGING_TTL_MINUTES=120
VISION_MODEL=gemini/gemini-2.5-flash
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5500","http://127.0.0.1:5500"]
