# Salin file ini menjadi .env di root repo, lalu isi SECRET_KEY dengan nilai acak yang panjang.
# File yang sama dipakai untuk run lokal maupun Docker:
#   - Lokal : dibaca otomatis oleh aplikasi.
#   - Docker: docker run --env-file .env ... / docker compose (env_file: .env).
# Jangan menambahkan DATABASE_PATH di sini: image Docker sudah memakai /data/app.db (volume).
# Contoh membuat nilai acak: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
