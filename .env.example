# Salin file ini ke path pilihan Anda, lalu isi SECRET_KEY dengan nilai acak yang panjang.
# File .env TIDAK dibaca otomatis. Berikan path-nya secara eksplisit:
#   - Lokal : ./run.sh --env-file .env
#   - Docker: ./run.sh --docker --env-file .env
#             docker run --env-file .env ...
# Jangan menambahkan DATABASE_PATH di sini: image Docker sudah memakai /data/app.db (volume).
# Contoh membuat nilai acak: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Vision AI: model LiteLLM dan satu API key generik untuk provider tersebut.
VISION_MODEL=gemini/gemini-3.5-flash-lite
VISION_API_KEY=replace-with-your-provider-api-key
# Ganti VISION_MODEL sesuai provider, misalnya:
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-4-5
#   deepseek/deepseek-chat
